# Keep the build context small and secrets out of the image.
.git
.gitignore
.env
*.md
!requirements.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Build artifacts (regenerated in-image / at runtime)
staticfiles/
export.json

# Large data — mounted as volumes at runtime, never baked into the image
data_pdf/
data_img/
output/

# Legacy Flask implementation (replaced by Django)
src/

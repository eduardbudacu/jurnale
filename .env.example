# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated hostnames the app will serve (e.g. jurnale.example.com,localhost)
DJANGO_ALLOWED_HOSTS=*
# Needed when behind HTTPS (comma-separated, with scheme): https://jurnale.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 when running behind a TLS-terminating reverse proxy
DJANGO_SECURE_PROXY=0
DJANGO_SECURE_COOKIES=0
# Session lifetime in seconds (default 14 days)
# DJANGO_SESSION_AGE=1209600

# The dashboard requires login. Optionally bootstrap the first account on
# container start (skipped if the user already exists). Remove after first run.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector). Host "db" matches the compose service.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://jurnale:jurnale@db:5432/jurnale
# Used by docker-compose to provision the db container:
POSTGRES_DB=jurnale
POSTGRES_USER=jurnale
POSTGRES_PASSWORD=jurnale

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
OCR_PROVIDER=openai
OCR_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Embeddings — used for /search and /ask retrieval.
#   EMBEDDING_PROVIDER=openai  -> text-embedding-3-large (3072-dim, matches schema)
#   EMBEDDING_PROVIDER=ollama  -> needs a dedicated embedding model (e.g.
#                                 nomic-embed-text); the dim must match the schema.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OLLAMA_URL=http://host.docker.internal:11434
# EMBEDDING_MODEL=nomic-embed-text

# Metadata extraction (Ollama). Required only for `metadata_worker`.
# OLLAMA_URL=http://host.docker.internal:11434
METADATA_MODEL=gemma3:12b

# ---------------------------------------------------------------------------
# RAG — "Ask your journals" (dashboard /ask). Answer synthesis uses the OpenAI
# chat API (OPENAI_API_KEY above); retrieval uses the embeddings configured above.
# ---------------------------------------------------------------------------
ANSWER_MODEL=gpt-4o
RAG_TOP_K=8
RAG_EXCERPT_CHARS=1500
